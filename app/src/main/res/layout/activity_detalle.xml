<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_page"
    tools:context=".ui.DetalleActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvDetalleNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre de la Apertura"
            android:textColor="@color/chess_wood_dark"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center_horizontal" />

        <TextView
            android:id="@+id/tvDetalleEco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@color/chess_wood_light"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="ECO: C60"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp" />

        <View
            android:layout_width="100dp"
            android:layout_height="2dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="20dp"
            android:background="@color/chess_wood_light" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MOVIMIENTOS PRINCIPALES"
            android:textColor="@color/chess_wood_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tvDetalleMovimientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/chess_white"
            android:elevation="2dp"
            android:fontFamily="monospace"
            android:padding="16dp"
            android:text="1. e4 e5 2. Nf3 Nc6"
            android:textColor="@color/chess_black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="ANÁLISIS TEÓRICO"
            android:textColor="@color/chess_wood_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tvDetalleDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Descripción detallada aquí..."
            android:textColor="@color/chess_black"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnReportar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Sugerir mejora por Correo"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:backgroundTint="@color/chess_accent"
            app:cornerRadius="8dp"
            app:icon="@android:drawable/ic_dialog_email"
            app:iconPadding="8dp" />

    </LinearLayout>
</ScrollView>